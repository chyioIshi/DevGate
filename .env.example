DEVGATE_HTTP_ADDR=:8080
DEVGATE_READ_HEADER_TIMEOUT=5s
DEVGATE_IDLE_TIMEOUT=60s
DEVGATE_SHUTDOWN_TIMEOUT=10s
DEVGATE_CONFIG_FILE=devgate.yaml
DEVGATE_LOG_FORMAT=text
DEVGATE_LOG_LEVEL=info
DEVGATE_UPSTREAM_RESPONSE_HEADER_TIMEOUT=10s
DEVGATE_UPSTREAM_MAX_ATTEMPTS=2
DEVGATE_UPSTREAM_RETRY_BASE_DELAY=100ms
DEVGATE_UPSTREAM_CIRCUIT_FAILURE_THRESHOLD=5
DEVGATE_UPSTREAM_CIRCUIT_OPEN_TIMEOUT=30s
